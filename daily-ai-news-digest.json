      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const pos = (row.Prioritize || row.prioritize || '').toString();\n  const neg = (row.Deprioritize || row.deprioritize || '').toString();\n  for (const t of pos.split(',').map(s => s.trim()).filter(Boolean)) {\n    out.push({ json: { text: t, weight: 1 } });\n  }\n  for (const t of neg.split(',').map(s => s.trim()).filter(Boolean)) {\n    out.push({ json: { text: t, weight: -1 } });\n  }\n}\nif (out.length === 0) {\n  out.push({ json: { text: 'general AI news', weight: 0 } });\n}\nreturn out;"
      },
