        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contents: [ { parts: [ { text: \"You are writing a daily AI news digest. For each article below, write one punchy, factual 1-2 sentence summary naming the organization/people and what happened. Do not restate the title verbatim or mention the source name in the summary text.\\n\\nReturn ONLY a JSON array of strings, one summary per article, in the exact same order as the articles below. No markdown, no other text.\\n\\nArticles:\\n\" + $json.articlesText } ] } ], generationConfig: { responseMimeType: \"application/json\" } } }}",
