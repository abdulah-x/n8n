        }
      }
    },
    {
      "parameters": {
        "jsCode": "const stories = $('Aggregate Top Stories').first().json.stories;\nconst raw = $json.candidates[0].content.parts[0].text;\nlet summaries;\ntry {\n  summaries = JSON.parse(raw);\n} catch (e) {\n  summaries = stories.map(() => raw.trim());\n}\nconst items = stories.map((s, i) => ({\n  title: s.title,\n  summary: (summaries[i] || s.contentSnippet || '').toString().trim(),\n  link: s.link,\n  source: s.sourceName,\n  articleVector: s.articleVector\n}));\nreturn [{ json: { items } }];"
      },
