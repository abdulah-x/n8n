    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Filter - Last 24h').item.json;\nconst articleVector = $('Embed Article (Gemini)').item.json.embedding.values;\nconst matches = $json.matches || [];\nconst dedupScore = matches.length ? matches[0].score : 0;\n\nconst prefVectors = $('Collect Prefs Embeddings').first().json.prefVectors;\nfunction cosine(a, b) {\n  let dot = 0, na = 0, nb = 0;\n  for (let i = 0; i < a.length; i++) {\n    dot += a[i] * b[i];\n    na += a[i] * a[i];\n    nb += b[i] * b[i];\n  }\n  return dot / (Math.sqrt(na) * Math.sqrt(nb) || 1);\n}\nlet prefScore = 0;\nfor (const p of prefVectors) {\n  prefScore += cosine(articleVector, p.vector) * p.weight;\n}\n\nreturn {\n  json: {\n    title: original.title,\n    link: original.link,\n    sourceName: original.sourceName,\n    pubDate: original.isoDate || original.pubDate,\n    contentSnippet: original.contentSnippet || original.content || '',\n    articleVector,\n    dedupScore,\n    prefScore\n  }\n};"
      },
