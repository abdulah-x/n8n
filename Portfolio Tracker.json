      "name": "Consolidate to 1 Item"
    },
    {
      "parameters": {
        "jsCode": "// Get the output from the \"Limit\" node\nconst inputData = $items(\"Consolidate to 1 Item\")[0].json;\nconst coinIds = inputData.coinIds;\nconst holdings = inputData.holdingData;\n\nconsole.log('=== DEBUG INFO ===');\nconsole.log('coinIds:', coinIds);\nconsole.log('holdings type:', typeof holdings);\nconsole.log('holdings is array:', Array.isArray(holdings));\nconsole.log('holdings length:', holdings ? holdings.length : 'null');\nconsole.log('holdings sample:', holdings ? holdings[0] : 'null');\n\n// --- 1. CALL THE API TO GET PRICES ---\nconst url = `https://api.coingecko.com/api/v3/simple/price?ids=${coinIds}&vs_currencies=usd&precision=full`;\n\nconsole.log('⚠️ Using free CoinGecko API - prices may be cached/delayed. For real-time prices, use CoinGecko Pro API.');\n\nconst prices = await this.helpers.httpRequest({\n  url: url,\n  method: 'GET',\n  json: true\n});\n\nconsole.log('API Response:', JSON.stringify(prices, null, 2));\n\n// --- 2. CALCULATE THE TOTAL ---\nlet total = 0;\nconst calculations = [];\n\nif (holdings && Array.isArray(holdings)) {\n  for (const coin of holdings) {\n    const coinId = coin['CoinGecko ID'] ? coin['CoinGecko ID'].trim() : null;\n    const amount = parseFloat(coin.Qty);\n    const price = prices[coinId] ? prices[coinId].usd : null;\n    \n    console.log(`Processing: ${coin['Coin Name']} | ID: ${coinId} | Qty: ${amount} | Price: ${price}`);\n    \n    if (coinId && prices[coinId] && prices[coinId].usd && !isNaN(amount)) {\n      const value = prices[coinId].usd * amount;\n      total += value;\n      calculations.push({\n        coin: coin['Coin Name'],\n        id: coinId,\n        qty: amount,\n        price: prices[coinId].usd,\n        value: value\n      });\n      console.log(`  ✓ Added ${value} to total`);\n    } else {\n      console.log(`  ✗ Skipped - Missing data`);\n    }\n  }\n}\n\nconsole.log('Final total:', total);\nconsole.log('Calculations:', JSON.stringify(calculations, null, 2));\n\n// --- 3. RETURN THE FINAL DATA ---\nconst now = new Date();\nconst date = now.toISOString().split('T')[0];\nconst time = now.toTimeString().split(' ')[0];\n\nreturn {\n  date: date,\n  time: time,\n  Value: total,\n  calculations: calculations\n};"
      },
